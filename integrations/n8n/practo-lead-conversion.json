              "name": "Authorization",
              "value": "Bearer {{$env.WHATSAPP_API_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ to: $('Preserve City & Speciality').item.json.phone, text: $json.autopilot.message, city_location: $('Preserve City & Speciality').item.json.city_location, speciality: $('Preserve City & Speciality').item.json.speciality, product_id: $('Preserve City & Speciality').item.json.product_id })}}",
        "options": {}
      },
      "id": "wa-send",
      "name": "WhatsApp Send Pitch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1040, -80]
    },
    {
      "parameters": {

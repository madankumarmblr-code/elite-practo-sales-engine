{
  "name": "Practo Lead → WhatsApp Autopilot → Commercial Proposal Suite",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "practo-lead-ingest",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-ingest",
      "name": "Webhook Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "practo-lead-ingest"
    },
    {
      "parameters": {
        "functionCode": "const b = items[0].json.body || items[0].json;\nconst city_location = b.city_location;\nconst speciality = b.speciality;\nif (!city_location || !speciality) {\n  throw new Error('city_location and speciality are required and must be preserved');\n}\nconst product_id = String(b.product_id || '').toUpperCase();\nif (!['PRACTO_RAY','PRACTO_PRIME','PRACTO_REACH'].includes(product_id)) {\n  throw new Error('product_id must be PRACTO_RAY | PRACTO_PRIME | PRACTO_REACH');\n}\nreturn [{ json: { ...b, city_location, speciality, product_id } }];"
      },
      "id": "validate-context",
      "name": "Preserve City & Speciality",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PRACTO_API_BASE}}/api/v1/leads/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Secret",
              "value": "={{$env.LEAD_INGEST_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "id": "api-ingest",
      "name": "API Lead Ingest + Pitch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.autopilot && $json.autopilot.message}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "has-pitch",
      "name": "Has WhatsApp Pitch?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WHATSAPP_SEND_URL}}",

PORT=5060
NODE_ENV=development
CORS_ORIGIN=*
DATA_DIR=./data

# Sarvam Voice Agents (Indus Samvaad)
SARVAM_VOICE_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_APP_ID=
SARVAM_AGENT_APP_VERSION=1
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_WEBHOOK_URL=/api/sarvam/webhook

# Meta Llama Model API (AI Intelligence)
META_LLAMA_API_KEY=

# Meta WhatsApp Cloud API (Delivery)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=elite_wa_verify_token_2026

# Auth — set a strong random secret in production
AUTH_TOKEN_SECRET=

# Vercel Blob (durable DB backup — only needed for Vercel deployment)
BLOB_READ_WRITE_TOKEN=

# Google Sheets CSV (optional inventory sync)
SHEET_CSV_URL=
SHEET_SYNC_MINUTES=15

# Optional: inject all secrets as JSON (overrides individual keys)
# INTEGRATION_SECRETS_JSON={"sarvam_voice":{"apiKey":"..."},"meta_whatsapp":{"accessToken":"..."}}
